# Copy to .env.local for local dev. Set the same values in Vercel → Project Settings → Environment Variables.

# --- Phase 1: dashboard login ---
DASHBOARD_PASSWORD=change-me
# Random 32+ bytes. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Phase 0/2: Google Nest (Smart Device Management) --- see docs/google-setup.md
SDM_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Phase 3: optional ---
# Broadcastify feeds for the radio tile: "Label|feedId" pairs. Pierce County directory: https://www.broadcastify.com/listen/ctid/2984
# Default is Tacoma PD South (15521). Add North once you have its id, e.g.:
# BROADCASTIFY_FEEDS=Tacoma PD South|15521,Tacoma PD North|12345
BROADCASTIFY_FEEDS=
# Premium Broadcastify direct stream; if set, a native audio player is used instead of the embed.
BROADCASTIFY_STREAM_URL=
# Override the news ticker sources. Comma-separated, optional "Label|" prefix per feed.
# Defaults (see src/lib/news.ts): News Tribune, Fox News, KIRO 7, BBC, FOX 13, NPR, KING 5, MyNorthwest, Tacoma Weekly, Suburban Times.
# NEWS_FEEDS=Fox News|https://moxie.foxnews.com/google-publisher/latest.xml, BBC|https://feeds.bbci.co.uk/news/world/rss.xml
NEWS_FEEDS=

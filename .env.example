# Copy to .env.local for local dev. Set the same values in Vercel → Project Settings → Environment Variables.

# --- Phase 1: dashboard login ---
DASHBOARD_PASSWORD=change-me
# Random 32+ bytes. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Phase 0/2: Google Nest (Smart Device Management) --- see docs/google-setup.md
SDM_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Phase 3: optional ---
# Premium Broadcastify direct stream; if unset the Broadcastify embed player is used.
BROADCASTIFY_STREAM_URL=
# Comma-separated RSS URLs to override the default news feeds.
NEWS_FEEDS=
